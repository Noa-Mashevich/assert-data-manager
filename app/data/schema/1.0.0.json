{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorePlan",
  "type": "object",
  "required": [
    "version",
    "corePlanName",
    "corePlanID",
    "variationName",
    "levels",
    "catalog"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "corePlanName": {
      "type": "string"
    },
    "corePlanID": {
      "type": "integer"
    },
    "variationName": {
      "type": "string"
    },
    "catalog": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "items": {
        "$ref": "#/$definitions/level"
      }
    }
  },
  "$definitions": {
    "level": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "elevation": {
          "type": "integer"
        }
      }
    }
  },
  "additionalProperties": false
}
