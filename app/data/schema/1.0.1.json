{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CorePlan Updated",
    "type": "object",
    "required": [
        "version",
        "corePlanName",
        "corePlanID",
        "variationName",
        "levels",
        "catalog"
    ],
    "properties": {
        "version": {
            "type": "string"
        },
        "corePlanName": {
            "type": "string"
        },
        "corePlanID": {
            "type": "string"
        },
        "variationName": {
            "type": "string"
        },
        "catalog": {
            "type": "string"
        },
        "levels": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "elevation"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "elevation": {
                        "type": "number"
                    },
                    "roofs": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "gables",
                                "roofEdges",
                                "roofSurfaces"
                            ],
                            "properties": {
                                "gables": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "gablePanelType",
                                            "gableEdges"
                                        ],
                                        "properties": {
                                            "gablePanelType": {
                                                "anyOf": [
                                                    {
                                                        "type": "null"
                                                    },
                                                    {
                                                        "type": "string"
                                                    }
                                                ]
                                            },
                                            "gableEdges": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "required": [
                                                        "startNode",
                                                        "endNode"
                                                    ],
                                                    "properties": {
                                                        "startNode": {
                                                            "$ref": "#/definitions/point3d"
                                                        },
                                                        "endNode": {
                                                            "$ref": "#/definitions/point3d"
                                                        }
                                                    },
                                                    "additionalProperties": false
                                                }
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "roofEdges": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "startNode",
                                            "endNode",
                                            "slope",
                                            "gableDepth"
                                        ],
                                        "properties": {
                                            "startNode": {
                                                "type": "object",
                                                "required": [
                                                    "x",
                                                    "y"
                                                ],
                                                "properties": {
                                                    "x": {
                                                        "type": "number"
                                                    },
                                                    "y": {
                                                        "type": "number"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "endNode": {
                                                "type": "object",
                                                "required": [
                                                    "x",
                                                    "y"
                                                ],
                                                "properties": {
                                                    "x": {
                                                        "type": "number"
                                                    },
                                                    "y": {
                                                        "type": "number"
                                                    }
                                                },
                                                "additionalProperties": false
                                            },
                                            "slope": {
                                                "type": "number"
                                            },
                                            "gableDepth": {
                                                "type": "number"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "roofSurfaces": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "surfaceEdges",
                                            "surfaceSlope",
                                            "surfaceInnerHoles"
                                        ],
                                        "properties": {
                                            "surfaceEdges": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "required": [
                                                        "startNode",
                                                        "endNode",
                                                        "edgeType"
                                                    ],
                                                    "properties": {
                                                        "startNode": {
                                                            "$ref": "#/definitions/point3d"
                                                        },
                                                        "endNode": {
                                                            "$ref": "#/definitions/point3d"
                                                        },
                                                        "edgeType": {
                                                            "type": "number"
                                                        },
                                                        "size": {
                                                            "type": "number"
                                                        },
                                                        "hasGutter": {
                                                            "type": "boolean"
                                                        },
                                                        "downspout": {
                                                            "anyOf": [
                                                                {
                                                                    "type": "null"
                                                                },
                                                                {
                                                                    "type": "object",
                                                                    "required": [
                                                                        "U",
                                                                        "z0",
                                                                        "z1"
                                                                    ],
                                                                    "properties": {
                                                                        "U": {
                                                                            "type": "array",
                                                                            "minItems": 1,
                                                                            "maxItems": 2,
                                                                            "items": {
                                                                                "type": "number"
                                                                            }
                                                                        },
                                                                        "z0": {
                                                                            "type": "number"
                                                                        },
                                                                        "z1": {
                                                                            "type": "number"
                                                                        }
                                                                    },
                                                                    "additionalProperties": false
                                                                }
                                                            ]
                                                        }
                                                    },
                                                    "additionalProperties": false
                                                }
                                            },
                                            "surfaceSlope": {
                                                "type": "number"
                                            },
                                            "surfaceInnerHoles": {
                                                "type": "array"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "rooms": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "category",
                                "function",
                                "type",
                                "centerXY",
                                "sizeXY",
                                "rotation90CounterClockWise",
                                "openings",
                                "roomInstances",
                                "floorSlope",
                                "panelType",
                                "gablePanelType",
                                "hasRoof",
                                "groupId"
                            ],
                            "properties": {
                                "category": {
                                    "type": "string"
                                },
                                "function": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "string"
                                },
                                "centerXY": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "sizeXY": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "rotation90CounterClockWise": {
                                    "type": "number"
                                },
                                "openings": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "id",
                                            "shiftDistance",
                                            "offsetX",
                                            "offsetY"
                                        ],
                                        "properties": {
                                            "id": {
                                                "type": "string"
                                            },
                                            "shiftDistance": {
                                                "type": "number"
                                            },
                                            "offsetX": {
                                                "type": "number"
                                            },
                                            "offsetY": {
                                                "type": "number"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "roomInstances": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "id",
                                            "offsetX",
                                            "offsetY"
                                        ],
                                        "properties": {
                                            "id": {
                                                "type": "string"
                                            },
                                            "offsetX": {
                                                "type": "number"
                                            },
                                            "offsetY": {
                                                "type": "number"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "floorSlope": {
                                    "anyOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "type": "object",
                                            "required": [
                                                "ratio",
                                                "directionXY"
                                            ],
                                            "properties": {
                                                "ratio": {
                                                    "type": "number"
                                                },
                                                "directionXY": {
                                                    "type": "array",
                                                    "minItems": 2,
                                                    "maxItems": 2,
                                                    "items": {
                                                        "type": "number"
                                                    }
                                                }
                                            },
                                            "additionalProperties": false
                                        }
                                    ]
                                },
                                "panelType": {
                                    "type": "array",
                                    "minItems": 4,
                                    "maxItems": 4,
                                    "items": {
                                        "anyOf": [
                                            {
                                                "type": "null"
                                            },
                                            {
                                                "type": "string"
                                            }
                                        ]
                                    }
                                },
                                "gablePanelType": {
                                    "type": "array",
                                    "minItems": 4,
                                    "maxItems": 4,
                                    "items": {
                                        "anyOf": [
                                            {
                                                "type": "null"
                                            },
                                            {
                                                "type": "string"
                                            }
                                        ]
                                    }
                                },
                                "hasRoof": {
                                    "type": "boolean"
                                },
                                "groupId": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    },
                    "arcAreas": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "areaType",
                                "areaContourPoints"
                            ],
                            "properties": {
                                "areaType": {
                                    "type": "string"
                                },
                                "areaContourPoints": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "point"
                                        ],
                                        "properties": {
                                            "point": {
                                                "$ref": "#/definitions/point3d"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "additionalProperties": true
                        }
                    },
                    "walls": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "startPoint",
                                "endPoint",
                                "classification",
                                "functionCode",
                                "offset",
                                "id",
                                "wallFlippped"
                            ],
                            "properties": {
                                "startPoint": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "endPoint": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "classification": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "functionCode": {
                                    "type": "string"
                                },
                                "offset": {
                                    "type": "number"
                                },
                                "id": {
                                    "type": "string"
                                },
                                "wallFlippped": {
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": true
                        }
                    },
                    "noWalls": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "startPoint",
                                "endPoint",
                                "id",
                                "wallFlippped"
                            ],
                            "properties": {
                                "startPoint": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "endPoint": {
                                    "type": "array",
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "id": {
                                    "type": "string"
                                },
                                "wallFlippped": {
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": true
                        }
                    },
                    "gravityWalls": {
                        "type": "array"
                    },
                    "shearWalls": {
                        "type": "array"
                    },
                    "beams": {
                        "type": "array"
                    },
                    "spatialWalls": {
                        "type": "object",
                        "properties": {
                            "DDL": {
                                "type": "array"
                            },
                            "GRG": {
                                "type": "array"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": false,
    "definitions": {
        "point3d": {
            "type": "object",
            "required": [
                "x",
                "y",
                "z"
            ],
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                },
                "z": {
                    "type": "number"
                }
            },
            "additionalProperties": false
        }
    }
}